# Frappe + ISM Connection Settings
FRAPPE_URL=http://localhost:8000
FRAPPE_API_KEY=your_api_key_here
FRAPPE_API_SECRET=your_api_secret_here

# Optional: multi-tenant site header (for benches behind reverse proxies)
# FRAPPE_SITE=development.localhost

# Optional: default Company override for Repair Orders
# ISM_DEFAULT_COMPANY=Lightspeed

# Optional: transport mode (auto, mcp, or rest)
# ISM_TRANSPORT=auto

# Optional: HTTP timeout in seconds
# ISM_MCP_TIMEOUT=30
