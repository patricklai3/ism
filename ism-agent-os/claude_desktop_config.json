{
  "mcpServers": {
    "ism-agent-os": {
      "command": "python",
      "args": [
        "/ABSOLUTE/PATH/TO/ism-agent-os/tools/ism_mcp_server.py"
      ],
      "env": {
        "FRAPPE_URL": "http://localhost:8000",
        "FRAPPE_API_KEY": "YOUR_FRAPPE_API_KEY",
        "FRAPPE_API_SECRET": "YOUR_FRAPPE_API_SECRET"
      }
    }
  }
}
